# Copia para .env.local e preenche com os dados do teu projeto Supabase
# (Supabase → Project Settings → API). Na Vercel, adiciona as mesmas variáveis
# em Settings → Environment Variables e faz um novo deploy.

# Públicas (vão para o browser; o RLS protege os dados)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: link (slug) do casamento mostrado na página inicial.
# Sem valor, mostra o primeiro casamento criado no painel.
NEXT_PUBLIC_WEDDING_SLUG=

# Opcional: email de contacto enviado ao Nominatim (OpenStreetMap) ao procurar
# moradas no mapa, como pede a política de uso deles.
NOMINATIM_CONTACT_EMAIL=
