# Copia para .env.local e preenche com os dados do teu projeto Supabase
# (Supabase → Project Settings → API). Na Vercel, adiciona as mesmas variáveis.

# Públicas (vão para o browser; o RLS protege os dados)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Casamento mostrado na página inicial (fase 1: um só casamento)
NEXT_PUBLIC_WEDDING_SLUG=maria-e-joao

# Contacto enviado ao Nominatim (OpenStreetMap) ao geocodificar a morada,
# exigido pela política de uso deles. Usa um email do projeto.
NOMINATIM_CONTACT_EMAIL=
